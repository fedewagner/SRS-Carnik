# Base de datos (Railway la inyecta en producción)
DATABASE_URL=postgresql://carnik:carnik@localhost:54329/carnik

# Sesión del backoffice: mínimo 32 caracteres aleatorios
SESSION_SECRET=

# Proveedor de AI. Con ORDER_DRAFTER=rules el sistema funciona sin ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ORDER_DRAFTER=rules

# meta = envía de verdad (fuera de esta entrega) | log = registra sin enviar
WHATSAPP_TRANSPORT=log

# Canal de simulación de mensajes entrantes (requiere además sesión)
SIMULATOR_ENABLED=true

# Contraseña de los usuarios sembrados (solo seed)
SEED_PASSWORD=

# Sólo si la API key no está asignada a un workspace
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5-5
