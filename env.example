# Base de datos (Railway la inyecta en producción)
DATABASE_URL=postgresql://carnik:carnik@localhost:54329/carnik

# Sesión del backoffice: mínimo 32 caracteres aleatorios
SESSION_SECRET=

# Proveedor de AI. Con ORDER_DRAFTER=rules el sistema funciona sin ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ORDER_DRAFTER=rules

# twilio = envía por WhatsApp a conversaciones reales | log = registra sin enviar
WHATSAPP_TRANSPORT=log

# Twilio WhatsApp Sandbox. Sin las cuatro, el webhook rechaza todo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL exacta configurada en la consola de Twilio; la firma se valida contra ella
TWILIO_WEBHOOK_URL=

# Canal de simulación de mensajes entrantes (requiere además sesión)
SIMULATOR_ENABLED=true

# Contraseña de los usuarios sembrados (solo seed)
SEED_PASSWORD=

# Sólo si la API key no está asignada a un workspace
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5-5
